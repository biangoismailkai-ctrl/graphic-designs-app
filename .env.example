# Copy this file to .env and fill it in
PORT=3000
ADMIN_EMAIL=biangoismailkai1@gmail.com
# At least 10 characters. Used only the first time the server starts.
ADMIN_PASSWORD=
# Needed only for the AI chatbot (get one at console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to production when the site is live on HTTPS
NODE_ENV=development
# Set to 1 if the host puts a proxy in front of the app (Render, Railway, nginx)
TRUST_PROXY=0
